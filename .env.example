# Frontend optional overrides (Vite)
# VITE_CONTACT_API_URL=/api/contact.php
# VITE_PHP_PROXY=http://127.0.0.1:8000

# Backend SMTP credentials (configure via server environment or server/mail-config.php outside webroot)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=support@vijayantech.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM_EMAIL=support@vijayantech.com
SMTP_FROM_NAME=VijayanTech
CONTACT_RECIPIENT_EMAIL=support@vijayantech.com
SITE_URL=https://vijayantech.com/
# Comma-separated allowed browser origins for CORS / origin checks (optional for same-origin hosting)
ALLOWED_ORIGINS=https://vijayantech.com,https://www.vijayantech.com
